# PostgreSQL
POSTGRES_USER=raguser
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ragdb
POSTGRES_PORT=5432

# Backend
ASPNETCORE_ENVIRONMENT=Development
BACKEND_PORT=5000

# JWT
# Generate a strong secret with: openssl rand -base64 64
JWT_KEY=change-me-to-a-long-random-string-at-least-64-characters
JWT_ISSUER=RagApp
JWT_AUDIENCE=RagAppClient
JWT_EXPIRES_MINUTES=120

# Ollama
# host.docker.internal points to the host machine from inside the container.
# Change to http://localhost:11434 if running the backend directly (not in Docker).
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=qwen3:4b

# File storage
FILE_STORAGE_PATH=/app/storage

# Frontend
FRONTEND_PORT=5173
